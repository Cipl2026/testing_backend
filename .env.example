NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ghaarfix
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_MAX=5
EXPOSE_OTP_IN_RESPONSE=false
ADMIN_EMAIL=admin@ghaarfix.in
ADMIN_PASSWORD=Admin@123456
CLIENT_URL=http://localhost:8081,http://localhost:8082
ADMIN_URL=http://localhost:5173

# Nimbus SMS (OTP delivery)
NIMBUS_USER=
NIMBUS_AUTHKEY=
NIMBUS_SENDER=
NIMBUS_ENTITY_ID=
# DigitalOcean Spaces (catalog image uploads — optional; falls back to local ./uploads)
# Use either DO_SPACES_KEY/DO_SPACES_SECRET or DO_SPACES_ACCESS_KEY/DO_SPACES_SECRET_KEY
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=ghaarfix
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_CDN_BASE=https://ghaarfix.blr1.cdn.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=