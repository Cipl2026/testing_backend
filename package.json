{
  "name": "@ghaarfix/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GhaarFix backend API",
  "main": "dist/server.js",
  "scripts": {
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && cp -r src/assets dist/assets",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@ghaarfix/shared-types": "file:./shared-types",
    "@ghaarfix/validation": "file:./shared-validation",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
